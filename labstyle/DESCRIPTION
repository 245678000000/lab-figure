Package: labstyle
Title: Lab Figure Style and Plot Templates
Version: 0.1.0
Description: House plotting style (theme, palettes, size presets, export) and
    parameterised plot templates (ROC, Kaplan-Meier, forest, box, violin,
    rate bar, AUC bar, correlation heatmap, pie) distilled from the lab's
    published analysis code.
License: file LICENSE
Encoding: UTF-8
Depends: R (>= 4.1.0)
Imports:
    ggplot2 (>= 3.5.0),
    patchwork,
    pROC,
    survival,
    ragg,
    grDevices,
    grid,
    stats,
    utils
Suggests:
    svglite,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
